<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gol.web-app.git-auto-commit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPO_PATH_PLACEHOLDER/general/git-auto-commit.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME_PLACEHOLDER/Library/Logs/com.gol.web-app.git-auto-commit.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME_PLACEHOLDER/Library/Logs/com.gol.web-app.git-auto-commit.error.log</string>
    <key>WorkingDirectory</key>
    <string>REPO_PATH_PLACEHOLDER</string>
</dict>
</plist>
