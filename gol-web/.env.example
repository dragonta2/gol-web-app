# GOL Web版｜環境変数のサンプルファイル（本番・ローカル共通で必要なもの）
# コピー: cp .env.example .env.local のあと、値を埋めてください。

# Supabase（必須）
# プロジェクトの URL と anon key（公開してもよいキー）。Supabase ダッシュボードの Settings > API から取得。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# OpenAI API（必須: AI判定・アドバイス・あらすじを使う場合）
# サーバー側のみで使用。クライアントに露出しない（NEXT_PUBLIC_ にしない）。
OPENAI_API_KEY=sk-...

# お知らせ・管理用（任意）
# カンマ区切りで管理者メールアドレスを指定。お知らせの追加・編集が可能になる。
# NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,other@example.com

# 以下はローカル・スクリプト用（本番では通常不要）
# マイグレーションスクリプトなどで RLS を超えた操作をする場合のみ使用。絶対にクライアントに渡さない。
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# TEST_USER_ID=uuid-for-test-user
