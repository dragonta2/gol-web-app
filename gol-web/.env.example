# GOL Web版｜環境変数のサンプルファイル（本番・ローカル共通で必要なもの）
# コピー: cp .env.example .env.local のあと、値を埋めてください。

# Supabase（必須）
# プロジェクトの URL と anon key（公開してもよいキー）。Supabase ダッシュボードの Settings > API から取得。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# OpenAI API（必須: AI判定・アドバイス・あらすじを使う場合）
# サーバー側のみで使用。クライアントに露出しない（NEXT_PUBLIC_ にしない）。
OPENAI_API_KEY=sk-...

# Notion（日誌取り込み機能用・任意）
# 【重要】このファイルには本物の API キーを書かない。実際の値は .env.local にのみ書く（.env.example は git にコミットされる）。
# 内部インテグレーションのシークレット（ntn_ で始まる文字列）。Notion の マイ設定 > インテグレーション で作成。
NOTION_API_KEY=ntn_xxxx
# 日誌データベースの ID（Notion の DB ページ URL の .../xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx の部分。実際の値は .env.local に書く）
NOTION_JOURNAL_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NOTION_DATE_PROPERTY_NAME（任意）
# Notion 日誌取り込み API（app/api/notion/import）が「いつ分の日誌か」を決めるときに使う、日付型プロパティの表示名。
# 未設定時は「日付」と「Date」をこの順で試す。DB 側の列名が違うと取り込みで見つからないので、そのときに指定する。
# カンマ区切りで複数書ける（例: 日付,Date,ジャーナル日付）。先頭から順に照合される。
# NOTION_DATE_PROPERTY_NAME=日付
# Notion 取り込みを許可するメールアドレス（カンマ区切り。未設定または空の場合は誰も使えない）。実際の値は .env.local に書く。
# NOTION_IMPORT_ALLOWED_EMAILS=user1@example.com,user2@example.com,user3@example.com

# お知らせ・管理用（任意）
# カンマ区切りで管理者メールアドレスを指定。お知らせの追加・編集が可能になる。
# NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,other@example.com
# レベルアップ必要EXPをマイページから変更できるテスト用メール（カンマ区切り）。管理者も変更可。
# NEXT_PUBLIC_TEST_EMAILS=test@example.com

# 以下はローカル・スクリプト用（本番では通常不要）
# マイグレーションスクリプトなどで RLS を超えた操作をする場合のみ使用。絶対にクライアントに渡さない。
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# TEST_USER_ID（任意）
# scripts/migrate-md-to-web.ts 用。CLI の第1引数で userId を渡さないときのフォールバック。
# 値は Supabase Auth のユーザー UUID。通常の Next 画面の動作には不要。
# TEST_USER_ID=uuid-for-test-user

# SYNC_TODOS_MD_FILE（任意）
# 経路 B（sync-todos.ts）を使うのにこの変数は必須ではない。未設定ならスクリプト内の既定パス（開発者向けの固定パス）が使われる。
# 別の場所の .md を同期したいときだけ指定する（別名・別フォルダ・別マシンでパスがずれる場合など）。そのときはフルパスを書く。
# scripts/sync-todos.ts が読む「やりたいことリスト」Markdown の絶対パス。
# 実行には NEXT_PUBLIC_ADMIN_EMAILS（先頭が同期先ユーザー）と SUPABASE_SERVICE_ROLE_KEY が必要。Vercel 本番とは無関係。
# SYNC_TODOS_MD_FILE=/absolute/path/to/やりたいこと・自動化したいことリスト.md
